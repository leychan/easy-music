<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="112dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@id/playback_cover"
        style="@style/PlaybackNotificationCover"
        android:layout_width="100dp"
        android:layout_height="100dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@id/playback_title"
            style="@style/PlaybackNotificationTitle" />

        <TextView
            android:id="@id/playback_artist"
            style="@style/PlaybackNotificationArtist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/playback_previous"
                style="@style/PlaybackNotificationButton.Expanded"
                android:contentDescription="@string/playback_notification_previous"
                android:src="@drawable/ic_notification_previous" />

            <ImageButton
                android:id="@id/playback_toggle"
                style="@style/PlaybackNotificationButton.Expanded"
                android:contentDescription="@string/playback_notification_play" />

            <ImageButton
                android:id="@id/playback_next"
                style="@style/PlaybackNotificationButton.Expanded"
                android:contentDescription="@string/playback_notification_next"
                android:src="@drawable/ic_notification_next" />

            <ImageButton
                android:id="@id/playback_favorite"
                style="@style/PlaybackNotificationButton.Expanded"
                android:contentDescription="@string/playback_notification_like"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
